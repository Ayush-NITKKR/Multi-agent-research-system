# ==========================================
# ResearchAI Environment Variables Template
# ==========================================

# AI Model & Search API Keys (Required)
MISTRAL_API_KEY=your_mistral_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
MISTRAL_MODEL=ministral-3b-2512

# Python AI Microservice Configuration
PYTHON_SERVICE_HOST=0.0.0.0
PYTHON_SERVICE_PORT=8000
PYTHON_SERVICE_URL=http://localhost:8000

# Node.js Express Backend Configuration
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/research_ai
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Frontend Vite Configuration
VITE_API_URL=http://localhost:5001/api
